[{"_1":2},"routes/manifest.webmanifest",{"_3":4},"data","{\n  \"id\": \"/\",\n  \"name\": \"holidayfinder\",\n  \"short_name\": \"holidayfinder\",\n  \"description\": \"Package holidays, flights, hotels, ski trips, cruises, events and car rental, with prices that include taxes and fees.\",\n  \"lang\": \"en-GB\",\n  \"dir\": \"ltr\",\n  \"start_url\": \"/\",\n  \"scope\": \"/\",\n  \"display\": \"standalone\",\n  \"background_color\": \"#f9fafb\",\n  \"theme_color\": \"#f9fafb\",\n  \"icons\": [\n    {\n      \"src\": \"/template/icon-192.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"/template/icon-512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"/template/icon-maskable-512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"maskable\"\n    },\n    {\n      \"src\": \"/template/favicon.svg\",\n      \"sizes\": \"any\",\n      \"type\": \"image/svg+xml\",\n      \"purpose\": \"any\"\n    }\n  ]\n}\n"]
