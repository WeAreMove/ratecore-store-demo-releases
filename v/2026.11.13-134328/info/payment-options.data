[{"_1":2,"_3":4},"root",{"_5":189},"routes/content-page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_15":42,"_21":32,"_17":43,"_44":45,"_46":47,"_48":49,"_19":50,"_51":52,"_53":54,"_9":55},"related",[11,12,13,14],{"_15":37,"_17":38,"_19":39,"_21":32},{"_15":32,"_17":33,"_19":34,"_21":32},{"_15":26,"_17":27,"_19":28,"_21":29},{"_15":16,"_17":18,"_19":20,"_21":22},"slug","book-with-confidence","title","Book with confidence","seo",{"_17":23,"_24":25},"area","company","Book with confidence | holidayfinder","description","Financial protection for package holidays, secure payment, free cancellation on selected hotels, Flex and 24/7 support while you travel.","terms-of-sale","Terms of sale",{"_17":30,"_24":31},"legal","Terms of sale | holidayfinder","The booking terms for holidays, flights, stays, cars, events and cruises bought from holidayfinder: payment, changes, cancellation and your protection.","help","Help Centre",{"_17":35,"_24":36},"Help Centre and FAQ | holidayfinder","Answers about booking, payment plans, changes and cancellations, holidayfinder®Flex, baggage, transfers, car rental and special assistance.","flex","holidayfinder®Flex",{"_17":40,"_24":41},"holidayfinder®Flex: cancel for any reason | holidayfinder","Cancel for any reason up to 24 hours before departure and get 90% of your trip price back. How Flex works, what it costs and what it covers.","payment-options","Payment options","lead","Pay in full, pay a deposit, spread the cost over 3 months at no extra cost, or split the payment. Choose what suits you at checkout.","published","2026-06-15","updated","2026-11-01",{"_17":187,"_24":188},"toc",true,"sections",[56,57,58,59,60,61,62,63],[37,32,26,16],{"_64":153,"_17":154,"_116":155,"_67":156},{"_64":148,"_17":149,"_67":150},{"_64":141,"_17":142,"_67":143},{"_64":131,"_17":132,"_116":133,"_67":134},{"_64":114,"_17":115,"_116":117,"_67":118},{"_64":102,"_17":103,"_67":104},{"_64":87,"_17":88,"_67":89},{"_64":65,"_17":66,"_67":68},"id","faq","Questions about paying","blocks",[69],{"_70":65,"_71":72},"type","items",[73,74,75],{"_76":84,"_78":85},{"_76":81,"_78":82},{"_76":77,"_78":79},"question","Which currency will I be charged in?","answer",[80],"You’re charged in the currency shown at checkout. If your card is in another currency, your bank may add a conversion fee.","Can I change the card for my next instalment or balance?",[83],"Yes. Contact us before the payment date and we’ll send you a secure link to update it.","Why was my payment declined?",[86],"Nothing is charged when a payment is declined. Check the card details, make sure your bank has approved the payment, or try another card, PayPal, Apple Pay or Google Pay.","security","Paying securely",[90,91,92],{"_70":99,"_97":101},{"_70":99,"_97":100},{"_70":93,"_94":95,"_17":96,"_97":98},"callout","status","tip","Tip","text","Paying by credit card can give you extra protection from your card provider. Ask your bank for details.","paragraph","Your bank may ask you to confirm the payment in its app or with a code. This extra check protects you against fraud.","Card payments are made on our payment provider’s secure, encrypted page. We never see or store your full card number.","methods","Payment methods we accept",[105,106],{"_70":108,"_71":109},{"_70":99,"_97":107},"Apple Pay and Google Pay are offered on devices that support them. You can save cards for next time in [Payment methods](/account/payment-methods).","list",[110,111,112,113],"Credit and debit cards: Visa, Mastercard and American Express","PayPal","Apple Pay","Google Pay","split","Split the payment","intro","Travelling with friends or family? Split the cost in one of two ways.",[119,120,121,122,123],{"_70":127,"_97":130},{"_70":99,"_97":129},{"_70":127,"_97":128},{"_70":99,"_97":126},{"_70":93,"_94":124,"_97":125},"info","If someone doesn’t pay their share within 48 hours, we let you know so you can pay it yourself or change the booking.","Pay your share now and we send a payment link to the other adults on the booking. Each person pays their own share on their own device within 48 hours.","heading","With the others travelling","Pay the total today with up to 3 of your own cards, and choose how much goes on each. This option takes cards only.","Between your own cards","instalments","Pay in 3 instalments","Spread the cost over 3 monthly payments with no interest and no fees.",[135],{"_70":108,"_71":136},[137,138,139,140],"The first instalment is taken today, the second and third on the same day of the following two months.","We charge the same payment method automatically on each date.","We email you a reminder 3 days before each payment.","Available when your departure is more than 12 weeks away, so everything is paid well before you travel.","deposit","Pay a deposit",[144,145],{"_70":99,"_97":147},{"_70":99,"_97":146},"The deposit amount and the balance date are shown at checkout and in your booking confirmation.","Secure your holiday with a deposit today. The balance is charged automatically to the same payment method on the date shown at checkout, usually 4 to 6 weeks before you travel.","pay-in-full","Pay in full",[151],{"_70":99,"_97":152},"Pay the whole price today and there’s nothing more to think about. You can use any of the payment methods we accept.","at-a-glance","Your options at a glance","The options available for your trip are shown at checkout. They depend on the trip and on when you travel.",[157],{"_70":158,"_159":160,"_161":162,"_163":164},"table","caption","Payment plans compared","columns",[183,184,185,186],"rows",[165,166,167,168],[149,180,181,182],[176,177,178,179],[172,173,174,175],[115,169,170,171],"Your share","Others pay their share by link within 48 hours","Bookings with more than one adult, or up to 3 of your cards","3 instalments","A third of the price","Two monthly payments, charged automatically","Departure more than 12 weeks away","Deposit","A deposit","The balance, charged automatically on the date shown","On many holidays","The whole price","Nothing more to pay","Always","Plan","Pay today","Then","Available when","Payment options: deposit, instalments, split | holidayfinder","Pay in full, pay a deposit, pay in 3 instalments at no extra cost or split the payment. Card, PayPal, Apple Pay and Google Pay accepted.",{"_190":191},"store",{"_64":192,"_193":192,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_19":204,"_205":206,"_207":208,"_29":209,"_210":211,"_212":213,"_214":215,"_216":217},"holidayfinder","name","currency","EUR","site",{"_974":975,"_976":977},"engine",{"_970":971,"_972":973},"footer",{"_789":886,"_887":888,"_259":889,"_890":891,"_892":893,"_29":894,"_895":896},"theme",{"_831":832,"_833":834,"_835":836,"_837":838,"_839":840,"_841":842,"_843":844},{"_822":823,"_24":824,"_825":826},"menu",{"_789":790},"preferences",{"_741":742,"_743":744,"_745":746,"_747":195},{"_739":740,"_255":256},"home",{"_240":241,"_242":243,"_244":245,"_246":247,"_248":249,"_250":251},"support",{"_230":231,"_232":233,"_234":235,"_236":237},"paymentMethods",[226,227,228,229],"announcement",{"_218":219,"_220":221},"message","Flexible payment plans — pay in 3 instalments at no extra cost.","link",{"_222":223,"_224":225},"label","Learn more","href","/info/payment-options","card","paypal","googlepay","applepay","whatsappHref","https://wa.me/447700900123","phone",{"_222":238,"_224":239},"email","help@holidayfinder.example","hours","Every day, 24 hours","020 7946 0123","tel:+442079460123","campaign",{"_17":729,"_294":730,"_731":732,"_278":733},"inspiration",{"_17":721,"_71":722},"inspirationByMode",{"_322":323,"_324":325,"_326":327,"_328":329,"_330":331,"_332":333,"_334":335},"themes",[306,307,308,309],"trust",[289,290,291,292],"newsletter",{"_17":252,"_253":254,"_255":256,"_257":258,"_259":260},"Deals and travel inspiration","subtitle","Weekly in your inbox, daily in your feed","privacyHref","/info/privacy-and-cookies","destinations",[271,272,273,274],"social",[261,262,263],{"_264":269,"_224":270},{"_264":267,"