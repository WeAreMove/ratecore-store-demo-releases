[{"_1":2,"_3":4},"root",{"_5":134},"routes/content-page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_14":36,"_20":21,"_37":7,"_38":39,"_40":41,"_16":42,"_43":44,"_45":46,"_47":48,"_18":49,"_50":51,"_9":52},"related",[11,12,13],{"_14":31,"_16":32,"_18":33,"_20":31},{"_14":25,"_16":26,"_18":27,"_20":28},{"_14":15,"_16":17,"_18":19,"_20":21},"slug","privacy-and-cookies","title","Privacy and cookies","seo",{"_16":22,"_23":24},"area","legal","Privacy and cookies | holidayfinder","description","How holidayfinder uses your personal data and cookies, who we share it with, how long we keep it and how to use your rights under UK GDPR.","contact-us","Contact us",{"_16":29,"_23":30},"company","Contact us: 24/7 support | holidayfinder","Reach holidayfinder’s travel experts 24/7 by WhatsApp, phone or email. Help before you book, during your trip and after you’re home.","help","Help Centre",{"_16":34,"_23":35},"Help Centre and FAQ | holidayfinder","Answers about booking, payment plans, changes and cancellations, holidayfinder®Flex, baggage, transfers, car rental and special assistance.","accessibility","kind","toc",true,"placeholder","Sample legal text for the white-label template. The store's own lawyers must replace it before launch; it is not legal advice.","Accessibility statement","lead","We want everyone to be able to plan and book a trip with holidayfinder. This statement explains how accessible our website and app are, and how to get help.","published","2026-03-01","updated","2026-11-01",{"_16":132,"_23":133},"sections",[53,54,55,56,57,58,59],[31,25,15],{"_60":127,"_16":128,"_63":129},{"_60":110,"_16":111,"_72":112,"_63":113},{"_60":101,"_16":102,"_63":103},{"_60":87,"_16":88,"_72":89,"_63":90},{"_60":82,"_16":83,"_63":84},{"_60":70,"_16":71,"_72":73,"_63":74},{"_60":61,"_16":62,"_63":64},"id","statement","About this statement","blocks",[65],{"_66":67,"_68":69},"type","paragraph","text","This statement was prepared on 1 March 2026 and last reviewed on 1 November 2026, after our latest accessibility review of the website and app.","feedback","Feedback and contact","intro","If you find a problem that isn’t listed here, or you need information in another format, please tell us. We aim to reply within 5 working days.",[75],{"_66":76,"_77":78},"contact","channels",[79,80,81],"whatsapp","phone","email","assistance","Help with your trip",[85],{"_66":67,"_68":86},"If you or someone travelling with you needs assistance at the airport, on the flight or at the hotel, let us know when you book or as soon as possible afterwards. We will pass your request to the airline, airport and hotel. See our [Help Centre](/info/help) or [contact us](/info/contact-us).","known-limitations","Known limitations","Some content comes from our suppliers and partners, and we can’t always make it fully accessible ourselves.",[91,92],{"_66":94,"_95":96},{"_66":67,"_68":93},"We are working with suppliers to fix these. If any of them stops you from booking, contact us and we will help you book another way.","list","items",[97,98,99,100],"Some hotel descriptions and photos from suppliers don’t have text descriptions.","Some documents from suppliers, such as PDF vouchers and tickets, may not work well with screen readers.","Payment pages and wallets run by our payment provider, PayPal, Apple and Google follow their own accessibility standards.","Some maps are hard to use without sight; the same information is always given in text.","how-we-test","How we test",[104],{"_66":94,"_95":105},[106,107,108,109],"Automated checks with axe run on every page, in light and dark mode, before each release.","We complete key journeys — searching, booking, paying and managing a booking — with a keyboard only and with screen readers.","Colours are checked for contrast, including in each store’s own brand colours.","We check pages at phone, tablet and desktop sizes and at high zoom.","what-you-can-do","What you can do","You should be able to:",[114,115],{"_66":94,"_95":120},{"_66":116,"_117":118,"_68":119},"callout","status","tip","AbilityNet has advice on making your device easier to use if you have a disability.",[121,122,123,124,125,126],"zoom in up to 400% without text spilling off the screen or content being lost;","search, book and manage your trip using only a keyboard;","use a screen reader such as VoiceOver, TalkBack or NVDA;","turn off animations: we respect your device’s reduce motion setting;","switch to dark mode, or follow your device’s setting;","read the site in right-to-left languages, with the layout mirrored.","commitment","Our commitment",[130],{"_66":67,"_68":131},"We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA on every page of our website and app. Accessibility is part of how we design and build every feature, not a check at the end.","Accessibility statement | holidayfinder","holidayfinder aims to meet WCAG 2.2 level AA. How to use the site with a keyboard, screen reader or zoom, known limitations and how to contact us.",{"_135":136},"store",{"_60":137,"_138":137,"_139":140,"_141":142,"_143":144,"_145":146,"_147":148,"_18":149,"_150":151,"_152":153,"_21":154,"_155":156,"_157":158,"_159":160,"_161":162},"holidayfinder","name","currency","EUR","site",{"_919":920,"_921":922},"engine",{"_915":916,"_917":918},"footer",{"_733":830,"_831":832,"_202":833,"_834":835,"_836":837,"_21":838,"_839":840},"theme",{"_775":776,"_777":778,"_779":780,"_781":782,"_783":784,"_785":786,"_787":788},{"_766":767,"_23":768,"_769":770},"menu",{"_733":734},"preferences",{"_685":686,"_687":688,"_689":690,"_691":140},{"_683":684,"_198":199},"home",{"_183":184,"_185":186,"_187":188,"_189":190,"_191":192,"_193":194},"support",{"_175":176,"_80":177,"_81":178,"_179":180},"paymentMethods",[171,172,173,174],"announcement",{"_163":164,"_165":166},"message","Flexible payment plans — pay in 3 instalments at no extra cost.","link",{"_167":168,"_169":170},"label","Learn more","href","/info/payment-options","card","paypal","googlepay","app