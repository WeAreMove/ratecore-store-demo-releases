[{"_1":2,"_3":4},"root",{"_5":165},"routes/content-page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_15":42,"_21":43,"_44":7,"_17":45,"_46":47,"_48":49,"_50":51,"_19":52,"_53":54,"_55":56,"_57":58,"_9":59},"related",[11,12,13,14],{"_15":37,"_17":38,"_19":39,"_21":34},{"_15":31,"_17":32,"_19":33,"_21":34},{"_15":26,"_17":27,"_19":28,"_21":22},{"_15":16,"_17":18,"_19":20,"_21":22},"slug","terms-of-sale","title","Terms of sale","seo",{"_17":23,"_24":25},"area","legal","Terms of sale | holidayfinder","description","The booking terms for holidays, flights, stays, cars, events and cruises bought from holidayfinder: payment, changes, cancellation and your protection.","cancellation-policy","Cancellation policy",{"_17":29,"_24":30},"Cancellation policy | holidayfinder","How to cancel a holidayfinder booking, the charges for holidays, hotels, flights, cars, events and cruises, Flex, and how long refunds take.","flex","holidayfinder®Flex",{"_17":35,"_24":36},"help","holidayfinder®Flex: cancel for any reason | holidayfinder","Cancel for any reason up to 24 hours before departure and get 90% of your trip price back. How Flex works, what it costs and what it covers.","payment-options","Payment options",{"_17":40,"_24":41},"Payment options: deposit, instalments, split | holidayfinder","Pay in full, pay a deposit, pay in 3 instalments at no extra cost or split the payment. Card, PayPal, Apple Pay and Google Pay accepted.","book-with-confidence","company","kind","Book with confidence","lead","How your money is protected, how we keep payments secure, and what we do if your plans change or something goes wrong while you are away.","published","2026-03-02","updated","2026-11-01",{"_17":163,"_24":164},"toc",true,"placeholder","ASSUMPTION: sample protection wording. The store must state its own licences and schemes (for example its ATOL number and trade memberships), confirmed by its lawyers, before launch.","sections",[60,61,62,63,64,65,66],[37,31,26,16],{"_67":149,"_17":150,"_70":151,"_72":152},{"_67":113,"_17":114,"_70":115,"_72":116},{"_67":101,"_17":102,"_70":103,"_72":104},{"_67":95,"_17":96,"_70":97,"_72":98},{"_67":31,"_17":90,"_70":91,"_72":92},{"_67":79,"_17":80,"_70":81,"_72":82},{"_67":68,"_17":69,"_70":71,"_72":73},"id","prices","Honest prices","intro","The price you see includes taxes and fees.","blocks",[74],{"_75":76,"_77":78},"type","paragraph","text","We show the total for everyone travelling, including taxes and mandatory fees. A small number of destinations charge a local tourist tax that you pay at the hotel; where that applies, we say so on the offer before you book.","support","24/7 support during your trip","If something goes wrong while you are away, contact us at any hour and we will help put it right.",[83],{"_75":84,"_85":86},"contact","channels",[87,88,89],"whatsapp","phone","email","Flex: cancel for any reason","Add holidayfinder®Flex when you book and cancel for any reason up to 24 hours before you travel.",[93],{"_75":76,"_77":94},"Flex costs 10% of the trip price. If you cancel, you get 90% of your trip back to your original payment method within 14 days. No proof or documents needed. See [holidayfinder®Flex](/info/flex).","free-cancellation","Free cancellation on selected hotels","Many hotels let you cancel for free until a date shown before you book.",[99],{"_75":76,"_77":100},"Look for \"Free cancellation\" on the room or rate. The exact date and time are shown on the offer and in your confirmation. After that date the hotel's cancellation charges apply. Read more in our [Cancellation policy](/info/cancellation-policy).","secure-payment","Secure payment","Your card details are handled by our payment provider on a secure page and never stored by us.",[105],{"_75":106,"_107":108},"list","items",[109,110,111,112],"Payments are encrypted and processed by a certified payment provider.","Your bank may ask you to confirm the payment in its app (Strong Customer Authentication).","Pay by card, PayPal, Apple Pay or Google Pay — see [Payment options](/info/payment-options).","We will never ask for your full card number by phone, email or WhatsApp.","what-is-covered","What is protected and what isn't","Protection depends on what you book and how you book it.",[117,118],{"_75":120,"_121":122,"_123":124,"_125":126},{"_75":76,"_77":119},"Financial protection covers supplier failure. It is not travel insurance: it does not cover illness, lost luggage or delays. We recommend that everyone travelling has suitable travel insurance.","table","caption","Financial protection by type of booking","columns",[147,148],"rows",[127,128,129,130,131,132,133],[145,146],[144,143],[142,143],[140,141],[138,139],[136,137],[134,135],"Event tickets only","Not a package; the organiser's terms apply","Car rental only","Not a package; the supplier's terms apply","Flight only","Not a package; the airline's terms apply","Hotel or apartment only","Not a package; the hotel's own cancellation terms apply","Cruise with flights","Protected as a package","Ski holiday with flights","Package holiday (flight and hotel)","Protected under the package travel rules and, for flights, our ATOL licence","Booking","Protection","protected","Your money is protected","Package holidays booked with us are financially protected, so you will not lose your money or be left stranded if a supplier fails.",[153,154,155],{"_75":76,"_77":162},{"_75":76,"_77":161},{"_75":156,"_157":158,"_17":159,"_77":160},"callout","status","tip","Check your confirmation","Your booking confirmation says which protection applies to each part of your trip. You can see it any time in [Manage my booking](/find-booking).","Flight-inclusive packages are also protected under our ATOL licence. Your confirmation shows the ATOL Certificate that applies to your booking and explains what it covers. Keep it with your travel documents.","When you book a flight and hotel together as a package, you have the protection of the UK's package travel rules. If we or a supplier in your package can no longer provide your holiday, you are entitled to a refund, or to a replacement holiday or to get home if you are already away.","Book with confidence | holidayfinder","Financial protection for package holidays, secure payment, free cancellation on selected hotels, Flex and 24/7 support while you travel.",{"_166":167},"store",{"_67":168,"_169":168,"_170":171,"_172":173,"_174":175,"_176":177,"_178":179,"_19":180,"_181":182,"_183":184,"_22":185,"_186":187,"_79":188,"_189":190,"_191":192},"holidayfinder","name","currency","EUR","site",{"_944":945,"_946":947},"engine",{"_940":941,"_942":943},"footer",{"_759":857,"_858":859,"_232":860,"_861":862,"_863":864,"_22":865,"_866":867},"theme",{"_802":803,"_804":805,"_806":807,"_808":809,"_810":811,"_812":813,"_814":815},{"_793":794,"_24":795,"_796":797},"menu",{"_759":760},"preferences",{"_711":712,"_713":714,"_715":716,"_717":171},{"_709":710,"_228":229},"home",{"_213":214,"_215":216,"_217":218,"_219":220,"_221":222,"_223":224},{"_205":206,"_88":207,"_89":208,"_209":210},"paymentMethods",[201,202,203,204],"announcement",{"_193":194,"_195":196},"message","Flexible payment plans — pay in 3 instalments at no extra cost.","link",{"_197":198,"_199":200},"label","Learn more","href","/info/payment-options","card","paypal","googlepay","applepay","whatsappHref","https://wa.me/447700900123",{"_197":211,"_199":212},"help@holidayfinder.example","hours","Every day, 24 hours","020 7946 0123","tel:+442079460123","campaign",{"_17":699,"_267":700,"_701":702,"_251":703},"inspiration",{"_17":691,"_107":692},"inspirationByMode",{"_292":293,"_294":295,"_296":297,"_298":299,"_300":301,"_302":303,"_304":305},"themes",[276,277,278,279],"trust",[262,263,264,265],"newsletter",{"_17":225,"_226":227,"_228":229,"_230":231,"_232":233},"Deals and travel inspiration","subtitle","Weekly in your inbox, daily in your feed","privacyHref","/info/privacy-and-cookies","destinations",[244,245,246,247],"social",[234,235,236],{"_237":242,"_199":243},{