[{"_1":2,"_3":4},"root",{"_5":244},"routes/content-page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_15":29,"_21":29,"_43":44,"_17":45,"_46":47,"_48":49,"_50":51,"_19":52,"_53":54,"_55":56,"_9":57},"related",[11,12,13,14],{"_15":37,"_17":38,"_19":39,"_21":40},{"_15":32,"_17":33,"_19":34,"_21":29},{"_15":26,"_17":27,"_19":28,"_21":29},{"_15":16,"_17":18,"_19":20,"_21":22},"slug","cancellation-policy","title","Cancellation policy","seo",{"_17":23,"_24":25},"area","legal","Cancellation policy | holidayfinder","description","How to cancel a holidayfinder booking, the charges for holidays, hotels, flights, cars, events and cruises, Flex, and how long refunds take.","flex","holidayfinder®Flex",{"_17":30,"_24":31},"help","holidayfinder®Flex: cancel for any reason | holidayfinder","Cancel for any reason up to 24 hours before departure and get 90% of your trip price back. How Flex works, what it costs and what it covers.","payment-options","Payment options",{"_17":35,"_24":36},"Payment options: deposit, instalments, split | holidayfinder","Pay in full, pay a deposit, pay in 3 instalments at no extra cost or split the payment. Card, PayPal, Apple Pay and Google Pay accepted.","contact-us","Contact us",{"_17":41,"_24":42},"company","Contact us: 24/7 support | holidayfinder","Reach holidayfinder’s travel experts 24/7 by WhatsApp, phone or email. Help before you book, during your trip and after you’re home.","kind","faq","Help Centre","lead","Answers to the questions travellers ask us most, from booking and paying to changes, baggage and special assistance. If you can’t find what you need, our team is here 24/7.","published","2026-06-15","updated","2026-11-02",{"_17":242,"_24":243},"toc",true,"sections",[58,59,60,61,62,63,64,65,66],[37,32,26,16],{"_67":216,"_17":217,"_72":218},{"_67":190,"_17":191,"_72":192},{"_67":168,"_17":169,"_72":170},{"_67":26,"_17":27,"_72":153},{"_67":136,"_17":137,"_72":138},{"_67":119,"_17":120,"_72":121},{"_67":102,"_17":103,"_72":104},{"_67":82,"_17":83,"_72":84},{"_67":68,"_17":69,"_70":71,"_72":73},"id","still-need-help","Still need help?","intro","Our team is here 24 hours a day, 7 days a week. Have your booking reference ready if you have one.","blocks",[74],{"_75":76,"_77":78},"type","contact","channels",[79,80,81],"whatsapp","phone","email","accessibility","Accessibility and special assistance",[85],{"_75":44,"_86":87},"items",[88,89,90],{"_91":99,"_93":100},{"_91":96,"_93":97},{"_91":92,"_93":94},"question","How do I find an accessible hotel room?","answer",[95],"Contact us before you book and we’ll check with the hotel which rooms suit your needs. Our [Accessibility statement](/info/accessibility) explains how we make this website work for everyone.","Can I travel with a wheelchair or mobility aid?",[98],"Yes. Airlines carry wheelchairs and mobility aids free of charge. Let us know the type, size and weight, and for powered chairs the battery type, so the airline can prepare.","How do I request special assistance at the airport?",[101],"Tell us at least 48 hours before you fly and we’ll ask the airline to arrange assistance at both airports. It’s free of charge.","car-hire","Car rental",[105],{"_75":44,"_86":106},[107,108,109],{"_91":116,"_93":117},{"_91":113,"_93":114},{"_91":110,"_93":111},"Can I add a second driver?",[112],"Usually, yes, at the rental desk. Additional drivers must show their own licence and may have to pay a daily fee.","Why is a deposit blocked on my card?",[115],"The rental company blocks a deposit on the main driver’s card at pick-up and releases it after the car is returned. It can take up to 14 days to show as available again.","What do I need to pick up my car?",[118],"The main driver needs a full driving licence, a passport or ID card and a credit card in their name for the deposit. The exact requirements are shown on each car before you book.","transfers","Transfers",[122],{"_75":44,"_86":123},[124,125,126],{"_91":133,"_93":134},{"_91":130,"_93":131},{"_91":127,"_93":128},"Can I add a transfer after booking?",[129],"Yes, as long as there is availability. Contact us at least 48 hours before you arrive.","What if my flight is delayed?",[132],"Your transfer provider tracks your flight and waits for you. If your flight number has changed, let us know so we can tell them.","How do I find my transfer at the airport?",[135],"Your transfer details, meeting point and the provider’s phone number are in your booking confirmation. Most drivers wait in the arrivals hall with a sign showing your name.","baggage","Baggage",[139],{"_75":44,"_86":140},[141,142,143],{"_91":150,"_93":151},{"_91":147,"_93":148},{"_91":144,"_93":145},"Can I take sports equipment or a pushchair?",[146],"Most airlines carry pushchairs free of charge. Skis, golf clubs and bikes usually need to be booked in advance for a fee. Contact us before you travel and we’ll arrange it with the airline.","Can I add a bag after booking?",[149],"Usually, yes. Adding bags before you fly is almost always cheaper than paying at the airport. Open your trip in [My bookings](/account/bookings) or contact us.","How much luggage can I take?",[152],"It depends on the airline and the fare. Your baggage allowance is shown on each flight before you book and in your booking confirmation.",[154],{"_75":44,"_86":155},[156,157,158],{"_91":165,"_93":166},{"_91":162,"_93":163},{"_91":159,"_93":160},"Is Flex travel insurance?",[161],"No. Flex is a holidayfinder service. It doesn’t cover medical costs, lost luggage or delays, so we recommend travel insurance as well.","How do I cancel with Flex?",[164],"Cancel in [My bookings](/account/bookings) or with our 24/7 support team, up to 24 hours before your first flight (or check-in, for stays). The refund reaches your original payment method within 14 days.","What is holidayfinder®Flex?",[167],"Flex lets you cancel for any reason, up to 24 hours before departure, and get 90% of your trip price back. It costs 10% of the trip price and is added at checkout. [Read more about Flex](/info/flex).","changes-and-cancellations","Changes and cancellations",[171],{"_75":44,"_86":172},[173,174,175,176],{"_91":187,"_93":188},{"_91":183,"_93":184},{"_91":180,"_93":181},{"_91":177,"_93":178},"What happens if my flight is cancelled or changed?",[179],"We’ll contact you by email and text with your options, usually a new flight or a full refund for the part affected. If your trip is protected, you won’t be left out of pocket.","When will I get my refund?",[182],"Refunds go back to the payment method you used. Once we have the money back from the airline or hotel, it usually takes 5 to 14 days to reach your account.","How do I cancel my booking?",[185,186],"Open your trip in [My bookings](/account/bookings) or [Manage my booking](/find-booking). You’ll see what you get back before you confirm.","What you get back depends on the conditions you booked with. Our [Cancellation policy](/info/cancellation-policy) explains how it works.","Can I change my booking?",[189],"Many bookings can be changed, depending on the airline’s and hotel’s rules. Open your trip in [My bookings](/account/bookings) to see what you can change and what it costs, or contact us.","payment","Payment",[193],{"_75":44,"_86":194},[195,196,197,198,199],{"_91":213,"_93":214},{"_91":210,"_93":211},{"_91":206,"_93":207},{"_91":203,"_93":204},{"_91":200,"_93":201},"Is it safe to pay on holidayfinder?",[202],"Yes. Card payments go through our payment provider’s secure page. We never see or store your full card number.","Can I split the payment?",[205],"Yes, in two ways. You can spread the total over up to 3 of your own cards, or share it with the other adults travelling: you pay your share and each of them pays theirs by link within 48 hours.","How do instalments work?",[208,209],"You can pay in 3 monthly instalments at no extra cost when your departure is more than 12 weeks away. The first instalment is taken today and the next two are charged automatically to the same payment method.","We email you a reminder 3 days before each payment. See [Payment options](/info/payment-options) for the details.","Can I pay a deposit?",[212],"On many holidays, yes. You pay a deposit today and the balance is charged automatically to the same payment method on the date shown at checkout, usually 4 to 6 weeks before you travel.","Which payment methods do you accept?",[215],"We accept Visa, Mastercard and American Express cards, PayPal, Apple Pay and Google Pay. The methods available for your trip are shown at checkout.","booking","Booking",[219],{"_75":44,"_86":220},[221,222,223,224,225],{"_91":238,"_93":239},{"_91":235,"_93":236},{"_91":232,"_93":233},{"_91":229,"_93":230},{"_91":226,"_93":227},"Are the prices I see the final prices?",[228],"Yes. Prices include taxes and our fees. Optional extras such as luggage, seats, transfers or holidayfinder®Flex are added only if you choose them, and the total is always shown before you pay.","The names on my booking are wrong. What should I do?",[231],"Names must match each traveller’s passport exactly. Contact us as soon as possible: small spelling corrections are often free, but some airlines charge for name changes or don’t allow them.","Do I need an account to book?",[234],"No. You can book as a guest. An account lets you see all your trips in one place, save travellers’ details for next time and keep [favourites](/favourites).","Where can I find my booking?",[237],"Signed in, go to [My bookings](/account/bookings). Without an account, use [Manage my booking](/find-booking) with your booking reference and the email address you booked with.","How do I know my booking is confirmed?",[240,241],"You’ll see a confirmation page with your booking reference as soon as payment goes through, and we email you a confirmation within a few minutes.","If the email hasn’t arrived after an hour, check your spam folder, then [find your booking](/find-booking) with your reference and email address.","Help Centre and FAQ | holidayfinder","Answers about booking, payment plans, changes and cancellations, holidayfinder®Flex, baggage, transfers, car rental and special assistance.",{"_245":246},"store",{"_67":247,"_248":247,"_249":250,"_251":252,"_253":254,"_255":256,"_257":258,"_19":259,"_260":261,"_262":263,"_22":264,"_265":266,"_267":268,"_269":270,"_271":272},"holidayfinder","name","currency","EUR","site",{"_1026":1027,"_1028":1029},"engine",{"_1022":1023,"_1024":1025},"footer",{"_843":939,"_940":941,"_312":942,"_943":944,"_945":946,"_22":947,"_948":949},"theme",{"_884":885,"_886":887,"_888":889,"_890":891,"_892":893,"_894":895,"_896":897},{"_875":876,"_24":877,"_878":879},"menu",{"_843":844},"preferences",{"_795":796,"_797":798,"_799":800,"_801":250},{"_793":794,"_308":309},"home",{"_293":294,"_295":296,"_297":298,"_299":300,"_301":302,"_303":304},"support",{"_285":286,"_80":287,"_81":288,"_289":290},"paymentMethods",[281,282,283,284],"announcement",{"_273":274,"_275":276},"message","Flexible payment plans — pay in 3 instalments at no extra cost.","link",{"_277":278,"_279":280},"label","Learn more","href","/info/payment-options","card","paypal","googlepay","applepay","whatsappHref","https://wa.me/447700900123",{"_277":291,"_279":292},"help@holidayfinder.example","hours","Every day, 24 hours","020 7946 0123","tel:+442079460123","campaign",{"_17":783,"_347":784,"_785":786,"_331":787},"inspiration",{"_17":775,"_86":776},"inspirationByMode",{"_375":376,"_377":378,"_379":380,"_381":382,"_383":384,"_385":386,"_387":388},"themes",[359,360,361,362],"trust",[342,343,344,345],"newsletter",{"_17":305,"_306":307,"_308":309,"_310":311,"_312":313},"Deals and travel inspiration","subtitle","Weekly in your inbox, daily in your feed","privacyHref","/info/privacy-and-cookies","destinations",[324,325,326,327],"social",[314,315,316],{"_317":322,"_279":323},{"_317":320,"_279":321},{"_317":318,"_279":319},"network","Facebook","https://www.facebook.com/holidayfinder","TikTok","https://www.tiktok.com/@holidayfinder","In