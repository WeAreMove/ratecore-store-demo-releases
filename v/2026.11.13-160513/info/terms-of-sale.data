[{"_1":2,"_3":4},"root",{"_5":201},"routes/content-page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_15":43,"_21":40,"_44":7,"_45":46,"_47":48,"_17":49,"_50":51,"_52":53,"_54":55,"_19":56,"_57":58,"_9":59},"related",[11,12,13,14],{"_15":37,"_17":38,"_19":39,"_21":40},{"_15":32,"_17":33,"_19":34,"_21":22},{"_15":26,"_17":27,"_19":28,"_21":29},{"_15":16,"_17":18,"_19":20,"_21":22},"slug","flex","title","holidayfinder®Flex","seo",{"_17":23,"_24":25},"area","help","holidayfinder®Flex: cancel for any reason | holidayfinder","description","Cancel for any reason up to 24 hours before departure and get 90% of your trip price back. How Flex works, what it costs and what it covers.","book-with-confidence","Book with confidence",{"_17":30,"_24":31},"company","Book with confidence | holidayfinder","Financial protection for package holidays, secure payment, free cancellation on selected hotels, Flex and 24/7 support while you travel.","payment-options","Payment options",{"_17":35,"_24":36},"Payment options: deposit, instalments, split | holidayfinder","Pay in full, pay a deposit, pay in 3 instalments at no extra cost or split the payment. Card, PayPal, Apple Pay and Google Pay accepted.","cancellation-policy","Cancellation policy",{"_17":41,"_24":42},"legal","Cancellation policy | holidayfinder","How to cancel a holidayfinder booking, the charges for holidays, hotels, flights, cars, events and cruises, Flex, and how long refunds take.","terms-of-sale","kind","toc",true,"placeholder","Sample legal text for the white-label template. The store's own lawyers must replace it before launch; it is not legal advice.","Terms of sale","lead","These terms form the contract when you book with holidayfinder. Please read them with the details of your offer, which are shown before you pay and in your confirmation.","published","2026-03-01","updated","2026-11-01",{"_17":199,"_24":200},"sections",[60,61,62,63,64,65,66,67,68,69,70,71,72,73,74],[37,32,26,16],{"_75":190,"_17":191,"_157":192,"_78":193},{"_75":178,"_17":179,"_78":180},{"_75":155,"_17":156,"_157":158,"_78":159},{"_75":150,"_17":151,"_78":152},{"_75":143,"_17":144,"_78":145},{"_75":136,"_17":137,"_78":138},{"_75":124,"_17":125,"_78":126},{"_75":16,"_17":18,"_78":121},{"_75":116,"_17":117,"_78":118},{"_75":111,"_17":112,"_78":113},{"_75":104,"_17":105,"_78":106},{"_75":97,"_17":98,"_78":99},{"_75":92,"_17":93,"_78":94},{"_75":85,"_17":86,"_78":87},{"_75":76,"_17":77,"_78":79},"id","law","Law and jurisdiction","blocks",[80],{"_81":82,"_83":84},"type","paragraph","text","These terms are governed by the law of England and Wales, and the courts of England and Wales can deal with any dispute. If you live in Scotland or Northern Ireland, you can also bring proceedings in your local courts.","liability","Our liability",[88,89],{"_81":82,"_83":91},{"_81":82,"_83":90},"We are not liable where a problem is caused by you, by a third party not connected with your package, or by unavoidable and extraordinary circumstances. For single services, the supplier is responsible for providing the service.","For packages, we are responsible for the proper performance of all the travel services in your package. Our liability is limited where international conventions limit the liability of airlines, hotels or other carriers, and, for losses other than personal injury, to three times the price of the package, as the law allows.","financial-protection","Financial protection",[95],{"_81":82,"_83":96},"Where your booking is a package, the money you pay us is financially protected, as described on our [Book with confidence](/info/book-with-confidence) page. If we become insolvent, you will get your money back or, if you are already abroad, you will be brought home.","problems-and-complaints","Problems during your trip and complaints",[100,101],{"_81":82,"_83":103},{"_81":82,"_83":102},"If we can’t resolve a complaint, we will tell you about the independent alternative dispute resolution scheme you can use.","If something isn’t right during your trip, tell the supplier and us straight away — our support team is available 24/7 — so we can try to put it right on the spot. If a problem can’t be solved during the trip, please send us your complaint within 28 days of your return.","special-requests","Special requests and accessibility",[107,108],{"_81":82,"_83":110},{"_81":82,"_83":109},"If you or anyone travelling has reduced mobility or a medical condition that may affect the trip, please tell us before you book so we can check the arrangements are suitable and request assistance from airlines and airports. See our [Help Centre](/info/help) or [Contact us](/info/contact-us).","Tell us about any special requests, such as a room type or dietary need, when you book. We pass them to the supplier but can’t guarantee them unless they are confirmed in writing.","passports-and-health","Passports, visas and health",[114],{"_81":82,"_83":115},"Before you book a package, we give you general information about passport and visa requirements for your destination. It is your responsibility to make sure every traveller has a valid passport, any visas or travel authorisations, and any vaccinations needed, and to check official government advice before you travel.","insurance","Travel insurance",[119],{"_81":82,"_83":120},"We strongly recommend that everyone travelling has travel insurance that covers cancellation, medical costs, personal liability and repatriation, from the day you book.",[122],{"_81":82,"_83":123},"Flex is an optional service you can add at booking for 10% of the trip price. With Flex, you can cancel the whole booking for any reason up to 24 hours before departure and get 90% of the trip price back within 14 days. The Flex fee is not refundable. Flex is a holidayfinder service, not an insurance policy. See [holidayfinder®Flex](/info/flex) for the full terms.","changes-by-us","Changes and cancellations by us or our suppliers",[127,128],{"_81":82,"_83":135},{"_81":129,"_130":131},"list","items",[132,133,134],"If a change is minor, we will let you know and the booking goes ahead.","If a change to a package is significant, you can accept it, take a suitable alternative if one is offered, or cancel with a full refund.","If we cancel your package, you get a full refund and, where the law requires it, compensation — unless we cancel because of unavoidable and extraordinary circumstances or because the minimum number of travellers was not reached and we told you in time.","Suppliers sometimes have to change arrangements, for example a flight time. We will tell you as soon as we can.","cancellation-by-you","Cancellation by you",[139,140],{"_81":82,"_83":142},{"_81":82,"_83":141},"You can cancel a package without a charge if unavoidable and extraordinary circumstances at your destination, such as a natural disaster, significantly affect the holiday.","You can cancel at any time. Cancellation charges depend on what you booked and how close to departure you cancel. They are explained in our [Cancellation policy](/info/cancellation-policy) and in the terms of your offer.","changes-by-you","Changes you make",[146,147],{"_81":82,"_83":149},{"_81":82,"_83":148},"You can transfer a package to another person who meets its conditions, if you tell us at least 7 days before departure. You and the new traveller are both responsible for any costs of the transfer.","You can ask to change your booking in [My bookings](/account/bookings) or by contacting us. Whether a change is possible, and what it costs, depends on the suppliers’ rules. You pay any difference in price and any supplier charges.","documents","Travel documents",[153],{"_81":82,"_83":154},"Your confirmation, vouchers and e-tickets are sent by email and are always available in [My bookings](/account/bookings). Please check them as soon as you receive them and tell us about any mistake straight away — some suppliers charge to correct names later.","prices-and-payment","Prices and payment","intro","The price you see at checkout includes taxes and charges known at the time of booking. Optional extras are shown separately.",[160,161,162,163,164],{"_81":82,"_83":177},{"_81":129,"_130":172},{"_81":82,"_83":171},{"_81":166,"_167":168,"_17":169,"_83":170},{"_81":82,"_83":165},"After you have booked a package, the price can only change in limited cases allowed by law, such as changes in fuel costs, taxes or exchange rates. We will tell you at least 20 days before departure. If the price rises by more than 8%, you can cancel with a full refund.","callout","status","warning","If a scheduled payment fails","We will email you and try again. If the balance or an instalment is still unpaid 7 days after its due date, we may cancel the booking and apply the cancellation charges in our [Cancellation policy](/info/cancellation-policy).","You can pay by card, PayPal, Apple Pay or Google Pay. Card details are entered on our payment provider’s secure page; we never see or store your full card number. See [Payment options](/info/payment-options) for details.",[173,174,175,176],"**in full** today;","**a deposit** today and the balance automatically on the date shown at checkout, usually 4 to 6 weeks before you travel;","**in 3 monthly instalments** at no extra cost, when you depart more than 12 weeks after booking;","**split** across up to 3 of your own cards, or shared with the people travelling with you, who pay their share by link within 48 hours.","Depending on the offer and your travel date, you can pay:","making-a-booking","Making a booking",[181,182],{"_81":129,"_184":46,"_130":185},{"_81":82,"_83":183},"The person who books must be 18 or over and accepts these terms for everyone on the booking.","ordered",[186,187,188,189],"You choose an offer and check the details: dates, travellers, room, flights, extras and the offer’s cancellation terms.","You enter the travellers’ names exactly as they appear in their passports or ID cards.","You pay, or pay the first amount of your chosen plan.","Your booking is confirmed when we send your confirmation email with a booking reference. Until then, no contract exists.","our-role","Our role in your booking","What we are responsible for depends on what you book.",[194],{"_81":129,"_130":195},[196,197,198],"**Package holidays** (for example a flight and hotel booked together): we are the organiser of your package and are responsible for every travel service in it, as the Package Travel Regulations require.","**Single services** (a flight, a hotel, a car, an event ticket or a cruise booked on its own): we act as an agent for the supplier. Your contract for that service is with the supplier, under its own terms, which we show you before you book.","**Linked travel arrangements**: if you book a further service with us after a first booking, we will tell you before you pay whether it forms a package or a linked arrangement, and what protection applies.","Terms of sale | holidayfinder","The booking terms for holidays, flights, stays, cars, events and cruises bought from holidayfinder: payment, changes, cancellation and your protection.",{"_202":203},"store",{"_75":204,"_205":204,"_206":207,"_208":209,"_210":211,"_212":213,"_214":215,"_19":216,"_217":218,"_219":220,"_40":221,"_222":223,"_224":225,"_226":227,"_228":229},"holidayfinder","name","currency","EUR","site",{"_987":988,"_989":990},"engine",{"_983":984,"_985":986},"footer",{"_802":900,"_901":902,"_271":903,"_904":905,"_906":907,"_40":908,"_909":910},"theme",{"_845":846,"_847":848,"_849":850,"_851":852,"_853":854,"_855":856,"_857":858},{"_836":837,"_24":838,"_839":840},"menu",{"_802":803},"preferences",{"_754":755,"_756":757,"_758":759,"_760":207},{"_752":753,"_267":268},"home",{"_252":253,"_254":255,"_256":257,"_258":259,"_260":261,"_262":263},"support",{"_242":243,"_244":245,"_246":247,"_248":249},"paymentMethods",[238,239,240,241],"announcement",{"_230":231,"_232":233},"message","Flexible payment plans — pay in 3 instalments at no extra cost.","link",{"_234":235,"_236":237},"label","Learn more","href","/info/payment-options","card","paypal","googlepay","applepay","whatsappHref","https://wa.me/447700900123","phone",{"_234":250,"_236":251},"email","help@holidayfinder.example","hours","Every day, 24 hours","020 7946 0123","tel:+442079460123","campaign",{"_17":742,"_306":743,"_744":745,"_290":746},"inspiration",{"_17":734,"_130":735},"inspirationByMode",{"_334":335,"_336":337,"_338":339,"_340":341,"_342":343,"_344":345,"_346":347},"themes",[318,319,320,321],"trust",[301,302,303,304],"newsletter",{"_17":264,"_265":266,"_267":268,"_269":270,"_271":272},"Deals and travel inspiration","subtitle","Weekly in your inbox, daily in your feed","privacyHref","/info/privacy-and-cookies","destinations",[283,284,285,286],"social",[273,274,275],{"_276":281,"_236":282},{"_276":279,"_236":280},{"_276":277,"_236":278},"network","Facebook","https://www.facebook.com/holidayfinder","TikTok","https://www.tiktok.com/@holidayfinder","Instagram","https://www.instagram.com/holidayfinder",{"_205":298,"_288":299,"_290":300},{"_205":295,"_288":296,"_290":297},{"_205":292,"_288":293,"_290":294},{"_205":287,"_288":289,"_290":291},"Santorini","fromPrice",580,"image","/template/newsletter/santorini.jpg","Tenerife",585,"/template/newsletter/tenerife.jpg","Malta",470,"/template/newsletter/malta.jpg","Rome",340,"/template/newsletter/rome.jpg",{"_17":315,"_306":316,"_308":317},{"_17":312,"_306":313,"_308":314},{"_17":310,"_306":311,"_308":224},{"_17":305,"_306":307,"_308":309},"Flexible options","body","Book now with free cancellation on many hotels","icon","flexible","24/7 support","Real people by chat, phone or WhatsApp","Secure payment","Your card details are encrypted and never stored with us","secure-payment","ICPL protected","Your money is safe if anything goes wrong","protected",{"_234":331,"_308":332,"_236":333},{"_234":328,"_308":329,"_236":330},{"_234":325,"_308":326,"_236":327},{"_234":322,"_308":323,"_236":324},"Family holidays","family","/ai-match?the